# Public browser configuration. These values are bundled during `next build`; do not put secrets here.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SITE_URL=

# Server-only internal review route. Use only for local development or Vercel Preview.
# Production ignores this flag even when it is set.
HEALTHMAP_PILOT_ENABLED=0

# Server-only administrator credentials, such as SUPABASE_SERVICE_ROLE_KEY, are deliberately
# not listed here. They must never use a NEXT_PUBLIC_ name and are not required for this app's smoke checks.
# The separate healthmap-data CLI reads HEALTHMAP_SUPABASE_SERVICE_ROLE_KEY only from its private process
# environment. Never add that value to this web application template, Vercel Preview, browser logs, or evidence.

# Set to 1 to disable react-grab and react-scan during local development.
NEXT_PUBLIC_DISABLE_REACT_DEVTOOLS=0
