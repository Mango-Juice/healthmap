{
  "name": "health-map",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:smoke": "node scripts/deploy/production-smoke.mjs",
    "deploy:validate": "node --experimental-strip-types scripts/deploy/validate-environment.mjs",
    "start": "next start",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --sequence.shuffle --sequence.seed=20260813",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "bash scripts/data/verify-local-db.sh --local",
    "test:e2e": "playwright test",
    "test:deployment": "node --experimental-strip-types --test tests/deployment/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "posthog-js-lite": "4.10.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
