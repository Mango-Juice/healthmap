{
  "name": "health-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:smoke": "node --experimental-strip-types scripts/deploy/production-smoke.mjs",
    "deploy:validate": "node --experimental-strip-types scripts/deploy/validate-environment.mjs",
    "deploy:validate-env": "node --experimental-strip-types scripts/deploy/validate-environment.mjs",
    "deploy:validate:hosted": "node --experimental-strip-types scripts/deploy/validate-environment.mjs --hosted",
    "data:audit": "vitest run --config vitest.data.config.ts && node --experimental-strip-types scripts/data/audit-catalog.mjs",
    "data:seed:generate": "node --experimental-strip-types scripts/data/generate-seed.mjs",
    "docs:check": "node scripts/docs/check-operations.mjs docs/operations.md",
    "start": "next start",
    "smoke:production": "pnpm deploy:smoke",
    "test:deployment": "node --experimental-strip-types --test tests/deployment/*.test.mjs",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:config && vitest run --sequence.shuffle --sequence.seed=20260813",
    "test:config": "node scripts/check-vercel-config.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "bash scripts/data/verify-local-supabase.sh",
    "test:e2e": "playwright test",
    "verify:domain": "node --no-warnings --experimental-strip-types scripts/domain-contract-driver.ts",
    "react:doctor": "react-doctor .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "next": "16.3.0",
    "posthog-js-lite": "4.10.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react-doctor": "0.9.12",
    "react-grab": "0.1.50",
    "react-scan": "0.5.7",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase"
    ]
  }
}
